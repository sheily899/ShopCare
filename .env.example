# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=

# Redis: local development placeholder only
REDIS_URL=redis://:your_local_redis_password_here@localhost:6379/0
REDIS_PASSWORD=your_local_redis_password_here

# ChromaDB: local host mapping defaults to 8001; containers use CHROMA_PORT=8000
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=.data/chroma

# Knowledge base and model
CUSTOMEROPS_KB_COLLECTION=knowledge_base_zh
CUSTOMEROPS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Skills and prompt limits
CUSTOMEROPS_SKILLS_DIR=./skills
CUSTOMEROPS_SKILLS_MAX_PROMPT_CHARS=5000

# Monitoring
LOG_LEVEL=INFO
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
CUSTOMEROPS_TOOL_TRACE_MAX=200
CUSTOMEROPS_COMPOSER_MAX_TOKENS=1000
CUSTOMEROPS_COMPOSER_TEMPERATURE=0.1

# Evaluation
EVAL_BASELINE_PATH=./data/eval/baseline.json
